# Copy to .env and replace every placeholder before startup.
NODE_ENV=production
WEB_PORT=8080
SITE_PORT=8081
APP_PUBLIC_URL=https://app.example.com
WEB_ORIGIN=https://app.example.com
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
QR_HMAC_SECRET=REPLACE_WITH_A_DIFFERENT_32_BYTE_RANDOM_SECRET
OTP_HMAC_SECRET=REPLACE_WITH_ANOTHER_DIFFERENT_32_BYTE_RANDOM_SECRET
DATABASE_URL=postgresql://psk:REPLACE_WITH_A_LONG_RANDOM_PASSWORD@localhost:5432/psk_meeting?schema=public
API_PORT=3000
# Mobile build: set EXPO_PUBLIC_API_URL to the public HTTPS API base URL.
EXPO_PUBLIC_API_URL=https://app.example.com
# Local web development only: VITE_API_URL=http://localhost:3000

# Optional Kavenegar SMS integration; keep disabled until credentials and sender are approved.
SMS_ENABLED=false
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
